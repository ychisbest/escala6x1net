---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  keywords?: string;
  includeHomeSchemas?: boolean;
  includeAdsense?: boolean;
  ogImagePath?: string;
  schemas?: Record<string, unknown>[];
  ogType?: string;
}

const {
  title = 'Escala 6x1 - Guia Completo sobre a Jornada de Trabalho 6x1 | Tudo o que Voce Precisa Saber',
  description = 'Entenda tudo sobre a escala 6x1: o que e, como funciona, direitos trabalhistas, propostas legislativas e impacto na saude e produtividade. Guia atualizada de 2026.',
  canonicalPath = '/',
  keywords = 'escala 6x1, jornada de trabalho 6x1, fim da escala 6x1, direitos trabalhistas, reducao da jornada, 44 horas semanais, descanso semanal, CLT, reforma trabalhista',
  includeHomeSchemas = true,
  includeAdsense = true,
  ogImagePath = '/og-image.svg',
  schemas = [],
  ogType = 'website',
} = Astro.props;

const siteOrigin = 'https://escala6x1.net';
const canonicalUrl = new URL(canonicalPath, siteOrigin).toString();
const ogImage = new URL(ogImagePath, siteOrigin).toString();
const isHome = canonicalPath === '/';
const adsenseClient = 'ca-pub-8738419268805262';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Escala6x1.net',
  url: 'https://escala6x1.net',
  logo: ogImage,
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  inLanguage: 'pt-BR',
  url: canonicalUrl,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Escala 6x1',
  url: 'https://escala6x1.net',
  description: 'Guia completo sobre a escala de trabalho 6x1.',
  inLanguage: 'pt-BR',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'O que e a escala 6x1?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A escala 6x1 e um modelo de jornada em que a pessoa trabalha 6 dias consecutivos e descansa 1 dia. A jornada diaria pode chegar a 8 horas, respeitando o limite de 44 horas semanais.',
      },
    },
    {
      '@type': 'Question',
      name: 'O fim da escala 6x1 ja foi aprovado?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Em dezembro de 2025, a CCJ do Senado aprovou uma proposta para encerrar a escala 6x1 e reduzir a jornada para 36 horas semanais. A proposta ainda depende de aprovacao em plenario.',
      },
    },
    {
      '@type': 'Question',
      name: 'Quantas horas se trabalha na escala 6x1?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Ate 44 horas semanais distribuidas em 6 dias. Em geral, 7h20 por dia ou 8h de segunda a sexta com 4h no sabado.',
      },
    },
    {
      '@type': 'Question',
      name: 'Qual a diferenca entre 6x1, 5x2 e 4x3?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '6x1: 6 dias de trabalho e 1 de descanso. 5x2: 5 dias de trabalho e 2 de descanso. 4x3: 4 dias de trabalho e 3 de descanso (proposta de 36h semanais).',
      },
    },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Escala 6x1: Guia Completo',
  author: {
    '@type': 'Organization',
    name: 'Escala6x1.net',
  },
  datePublished: '2026-01-15',
  dateModified: '2026-02-28',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: 'https://escala6x1.net/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'O que e?',
      item: 'https://escala6x1.net/#que-es',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Legislacao',
      item: 'https://escala6x1.net/#legislacion',
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: 'FAQ',
      item: 'https://escala6x1.net/#faq',
    },
  ],
};

const structuredData = [
  organizationSchema,
  webPageSchema,
  ...(includeHomeSchemas ? [websiteSchema, faqSchema, articleSchema, breadcrumbSchema] : []),
  ...schemas,
];
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Escala6x1.net" />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Escala6x1.net" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    {
      isHome && (
        <>
          <link rel="alternate" hreflang="pt-BR" href="https://escala6x1.net/" />
          <link rel="alternate" hreflang="x-default" href="https://escala6x1.net/" />
        </>
      )
    }

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Source+Sans+3:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    {
      includeAdsense && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
          crossorigin="anonymous"
        ></script>
      )
    }
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "vow5ntuth1");
    </script>

    {
      structuredData.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
      ))
    }
  </head>

  <body class="bg-ink-950 text-ink-200 antialiased">
    <a
      href="#conteudo-principal"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-brand-500 text-white px-4 py-2 rounded z-50"
      >Ir para o conteudo principal</a
    >
    <slot />
  </body>
</html>
