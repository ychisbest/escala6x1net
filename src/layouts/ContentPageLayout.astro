---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  heading: string;
  description: string;
  canonicalPath: string;
  updatedAt?: string;
}

const { title, heading, description, canonicalPath, updatedAt = '28 de febrero de 2026' } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  includeHomeSchemas={false}
>
  <header class="sticky top-0 z-40 border-b border-ink-800/60 bg-ink-950/95 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-3 group">
        <div
          class="w-10 h-10 bg-brand-500 rounded-lg flex items-center justify-center font-mono text-sm font-bold text-white group-hover:bg-brand-400 transition-colors"
        >
          6×1
        </div>
        <div><span class="font-display text-lg text-white">Escala6x1</span><span class="text-brand-500">.net</span></div>
      </a>
      <nav class="hidden md:flex items-center gap-4 text-sm">
        <a href="/" class="text-ink-300 hover:text-brand-400 transition-colors">Inicio</a>
        <a href="/about/" class="text-ink-300 hover:text-brand-400 transition-colors">Sobre Nosotros</a>
        <a href="/contact/" class="text-ink-300 hover:text-brand-400 transition-colors">Contacto</a>
        <a href="/privacy-policy/" class="text-ink-300 hover:text-brand-400 transition-colors">Privacidad</a>
        <a href="/terms-of-service/" class="text-ink-300 hover:text-brand-400 transition-colors">Términos</a>
      </nav>
    </div>
  </header>

  <main id="contenido-principal" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <article class="bg-ink-900/40 border border-ink-800/50 rounded-2xl p-6 md:p-10">
      <p class="text-xs tracking-wide uppercase text-ink-400 mb-3">Última actualización: {updatedAt}</p>
      <h1 class="font-display text-3xl md:text-5xl text-white leading-tight mb-6">{heading}</h1>
      <div class="space-y-5 text-ink-300 leading-relaxed">
        <slot />
      </div>
    </article>
  </main>

  <footer class="border-t border-ink-800/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col md:flex-row gap-3 md:items-center md:justify-between">
      <p class="text-sm text-ink-500">&copy; 2026 Escala6x1.net</p>
      <nav class="flex flex-wrap gap-x-4 gap-y-2">
        <a href="/about/" class="text-sm text-ink-400 hover:text-brand-400 transition-colors">Sobre Nosotros</a>
        <a href="/contact/" class="text-sm text-ink-400 hover:text-brand-400 transition-colors">Contacto</a>
        <a href="/privacy-policy/" class="text-sm text-ink-400 hover:text-brand-400 transition-colors">Política de Privacidad</a>
        <a href="/terms-of-service/" class="text-sm text-ink-400 hover:text-brand-400 transition-colors">Términos de Uso</a>
        <a href="/disclaimer/" class="text-sm text-ink-400 hover:text-brand-400 transition-colors">Descargo de Responsabilidad</a>
      </nav>
    </div>
  </footer>
</BaseLayout>
