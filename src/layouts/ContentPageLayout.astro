---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  heading: string;
  description: string;
  canonicalPath: string;
  updatedAt?: string;
  includeAdsense?: boolean;
  schemas?: Record<string, unknown>[];
}

const {
  title,
  heading,
  description,
  canonicalPath,
  updatedAt = '28 de fevereiro de 2026',
  includeAdsense = false,
  schemas = [],
} = Astro.props;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: 'https://escala6x1.net/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: heading,
      item: `https://escala6x1.net${canonicalPath}`,
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  includeHomeSchemas={false}
  includeAdsense={includeAdsense}
  schemas={[breadcrumbSchema, ...schemas]}
  ogType="article"
>
  <header class="sticky top-0 z-40 border-b border-ink-800/60 bg-ink-950/95 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-3 group">
        <div
          class="w-10 h-10 bg-brand-500 rounded-lg flex items-center justify-center font-mono text-sm font-bold text-white group-hover:bg-brand-400 transition-colors"
        >
          6×1
        </div>
        <div><span class="font-display text-lg text-white">Escala6x1</span><span class="text-brand-500">.net</span></div>
      </a>
      <nav class="hidden md:flex items-center gap-4 text-sm">
        <a href="/" class="text-ink-300 hover:text-brand-400 transition-colors">Inicio</a>
        <a href="/about/" class="text-ink-300 hover:text-brand-400 transition-colors">Sobre nos</a>
        <a href="/contact/" class="text-ink-300 hover:text-brand-400 transition-colors">Contato</a>
        <a href="/privacy-policy/" class="text-ink-300 hover:text-brand-400 transition-colors">Privacidade</a>
        <a href="/terms-of-service/" class="text-ink-300 hover:text-brand-400 transition-colors">Termos</a>
      </nav>
    </div>
  </header>

  <main id="conteudo-principal" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <nav aria-label="Navegacao estrutural" class="mb-5 text-sm text-ink-400">
      <a href="/" class="hover:text-brand-400 transition-colors">Inicio</a>
      <span class="mx-2 text-ink-600">/</span>
      <span>{heading}</span>
    </nav>
    <article class="bg-ink-900/40 border border-ink-800/50 rounded-2xl p-6 md:p-10">
      <p class="text-xs tracking-wide uppercase text-ink-400 mb-3">Ultima atualizacao: {updatedAt}</p>
      <h1 class="font-display text-3xl md:text-5xl text-white leading-tight mb-6">{heading}</h1>
      <div class="space-y-5 text-ink-300 leading-relaxed">
        <slot />
      </div>
    </article>
  </main>

  <footer class="border-t border-ink-800/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col md:flex-row gap-3 md:items-center md:justify-between">
      <p class="text-sm text-ink-500">&copy; 2026 Escala6x1.net</p>
      <nav class="flex flex-wrap gap-x-4 gap-y-2">
        <a href="/about/" class="text-sm text-ink-400 hover:text-brand-400 transition-colors">Sobre nos</a>
        <a href="/contact/" class="text-sm text-ink-400 hover:text-brand-400 transition-colors">Contato</a>
        <a href="/privacy-policy/" class="text-sm text-ink-400 hover:text-brand-400 transition-colors">Politica de Privacidade</a>
        <a href="/terms-of-service/" class="text-sm text-ink-400 hover:text-brand-400 transition-colors">Termos de Uso</a>
        <a href="/disclaimer/" class="text-sm text-ink-400 hover:text-brand-400 transition-colors">Aviso Legal</a>
      </nav>
    </div>
  </footer>
</BaseLayout>
